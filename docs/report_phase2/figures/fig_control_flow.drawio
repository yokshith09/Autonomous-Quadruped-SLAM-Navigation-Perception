<mxfile host="app.diagrams.net"><diagram name="Control flow"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1150" pageHeight="1560"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="&lt;b&gt;Start&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290.0" y="20" width="220" height="64" as="geometry"/></mxCell><mxCell id="load" value="&lt;b&gt;Load scene profile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;map size, operator route, return point&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200.0" y="120" width="400" height="84" as="geometry"/></mxCell><mxCell id="cal" value="&lt;b&gt;Stand still: calibrate the gyro&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200.0" y="240" width="400" height="70" as="geometry"/></mxCell><mxCell id="read" value="&lt;b&gt;Read sensors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;depth frame, leg odometry, gyro&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="190.0" y="350" width="420" height="84" as="geometry"/></mxCell><mxCell id="loc" value="&lt;b&gt;Localise&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;odometry prediction, scan-to-submap&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;ICP, loop closure&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200.0" y="470" width="400" height="96" as="geometry"/></mxCell><mxCell id="map" value="&lt;b&gt;Update the occupancy map&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200.0" y="602" width="400" height="70" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Route waypoint&lt;br&gt;left?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="235.0" y="710" width="330" height="140" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Unexplored&lt;br&gt;frontier left?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="235.0" y="900" width="330" height="140" as="geometry"/></mxCell><mxCell id="done" value="&lt;b&gt;Exploration complete&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200.0" y="1090" width="400" height="70" as="geometry"/></mxCell><mxCell id="home" value="&lt;b&gt;Return to the start point&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;(or the point given by the operator)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200.0" y="1200" width="400" height="90" as="geometry"/></mxCell><mxCell id="end" value="End: map and run report saved" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240.0" y="1330" width="320" height="70" as="geometry"/></mxCell><mxCell id="tw" value="&lt;b&gt;Goal = next route waypoint&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670.0" y="745" width="400" height="70" as="geometry"/></mxCell><mxCell id="tf" value="&lt;b&gt;Goal = best frontier viewpoint&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670.0" y="935" width="400" height="70" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;Plan an A* path to the goal&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670.0" y="1060" width="400" height="70" as="geometry"/></mxCell><mxCell id="walk" value="&lt;b&gt;Walk the path (trot gait)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;collision and floor-edge checks&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670.0" y="1170" width="400" height="84" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Making&lt;br&gt;progress?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720.0" y="1290" width="300" height="130" as="geometry"/></mxCell><mxCell id="wd" value="&lt;b&gt;Watchdog: turn away, skip goal&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="670.0" y="1460" width="400" height="70" as="geometry"/></mxCell><mxCell id="j" value="" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1124" y="1354" width="2" height="2" as="geometry"/></mxCell><mxCell id="e0" value=