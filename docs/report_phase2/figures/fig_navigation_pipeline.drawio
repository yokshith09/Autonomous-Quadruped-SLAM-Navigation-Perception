<mxfile host="app.diagrams.net"><diagram name="Navigation architecture"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sup" value="&lt;b&gt;Supervisor agent  (2 Hz)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;mission state, knowledge graph of rooms, event timeline&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="20" width="660" height="96" as="geometry"/></mxCell><mxCell id="bus" value="&lt;b&gt;Message bus (publish / subscribe)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;every agent reads the latest message on each topic&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="1440" height="76" as="geometry"/></mxCell><mxCell id="per" value="&lt;b&gt;Perception agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;10 Hz&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;depth frame to&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;2D obstacle scan&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;out: sensor/scan&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="222" height="200" as="geometry"/></mxCell><mxCell id="slam" value="&lt;b&gt;SLAM agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;10 Hz&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;pose from odometry,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;ICP and loop closure&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;out: pose/slam&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="273.6" y="360" width="222" height="200" as="geometry"/></mxCell><mxCell id="map" value="&lt;b&gt;Mapping agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;10 Hz&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;occupancy grid,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;rooms, doorways&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;out: map/grid&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="517.2" y="360" width="222" height="200" as="geometry"/></mxCell><mxCell id="fro" value="&lt;b&gt;Frontier agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;1 Hz&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;next goal: route&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;waypoint or frontier&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;out: frontier/target&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760.8000000000001" y="360" width="222" height="200" as="geometry"/></mxCell><mxCell id="pla" value="&lt;b&gt;Planning agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;5 Hz&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;A* path on the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;inflated grid&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;out: plan/path&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1004.4000000000001" y="360" width="222" height="200" as="geometry"/></mxCell><mxCell id="loc" value="&lt;b&gt;Locomotion agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;20 Hz&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;trot gait, watchdog,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;edge check&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;out: control/actuation&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1248.0" y="360" width="222" height="200" as="geometry"/></mxCell><mxCell id="kin" value="Kinect depth&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;+ colour frames&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="182" height="70" as="geometry"/></mxCell><mxCell id="legs" value="joint commands&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;to the 12 leg joints&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1240" y="640" width="215" height="70" as="geometry"/></mxCell><mxCell id="note" value="One 20 Hz scheduler runs every agent at its own rate.&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Agents never call each other: each one only reads and writes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;messages on the bus, so any agent can be changed or replaced alone.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Leg odometry and gyro reach SLAM through control/actuation.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="640" width="840" height="120" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;exitX=0.5;exitY=0;entryX=0.07708333333333334;entryY=1;startArrow=block;startFill=1;" edge="1" parent="1" source="per" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;exitX=0.5;exitY=0;entryX=0.24625000000000002;entryY=1;startArrow=block;startFill=1;" edge="1" parent="1" source="slam" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;exitX=0.5;exitY=0;entryX=0.4154166666666667;entryY=1;startArrow=block;startFill=1;" edge="1" parent="1" source="map" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;exitX=0.5;exitY=0;entryX=0.5845833333333333;entryY=1;startArrow=block;startFill=1;" edge="1" parent="1" source="fro" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;exitX=0.5;exitY=0;entryX=0.75375;entryY=1;startArrow=block;startFill=1;" edge="1" parent="1" source="pla" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;exitX=0.5;exitY=0;entryX=0.9229166666666667;entryY=1;startArrow=block;startFill=1;" edge="1" parent="1" source="loc" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;exitX=0.5;exitY=1;entryX=0.5;entryY=0;startArrow=block;startFill=1;" edge="1" parent="1" source="sup" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="kin" target="per"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="loc" target="legs"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>